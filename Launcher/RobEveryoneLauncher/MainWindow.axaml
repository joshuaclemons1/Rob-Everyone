<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="RobEveryoneLauncher.MainWindow"
        x:Name="Root"
        Title="Rob Everyone"
        Width="960" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="Black">

  <!--
    EA-style launcher shape: one large borderless splash image filling the
    window, a slim progress bar spanning the full width of the bottom edge,
    a status line just above it. No title bar, no window chrome; Escape
    (wired in code-behind) is the only way to close it before it hands off
    to the game.

    Swapping in real splash art: replace the Image below's Source with
    `avares://RobEveryoneLauncher/Assets/splash.png` (add the file under
    Assets/ and mark it AvaloniaResource in the .csproj, same as the default
    icon already is) and delete the placeholder Border+TextBlock title. Until
    then this renders a plain gradient + wordmark so the shape of the layout
    is real and previewable without needing final art.
  -->
  <Grid>
    <!-- Placeholder splash background; swap for a real Image, see above. -->
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#1A1F2C" Offset="0.0" />
          <GradientStop Color="#3A2740" Offset="0.55" />
          <GradientStop Color="#5C2A2A" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <TextBlock Text="ROB EVERYONE"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="64" FontWeight="Black" Foreground="White"
               Opacity="0.92" Margin="0,0,0,60" />

    <!-- Bottom status strip: message line + full-width slim progress bar. -->
    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0">
      <TextBlock x:Name="StatusText"
                 Text="Checking for updates..."
                 Foreground="White" Opacity="0.85"
                 FontSize="14" Margin="18,0,18,6" />
      <ProgressBar x:Name="Progress"
                   Minimum="0" Maximum="1" Value="0"
                   Height="6" Margin="0"
                   CornerRadius="0"
                   Background="#33000000"
                   Foreground="#E3505A" />
    </StackPanel>
  </Grid>
</Window>
